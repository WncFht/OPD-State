{
  "name": "opd-state",
  "private": true,
  "scripts": {
    "format": "prettier --write \"**/*.{md,yaml,yml,json,jsonc,cjs}\"",
    "format:check": "prettier --check \"**/*.{md,yaml,yml,json,jsonc,cjs}\"",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "check": "python3 scripts/run_checks.py --config scripts/checks.json --mode ci"
  },
  "devDependencies": {
    "git-format-staged": "4.0.2",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.6",
    "katex": "0.19.0"
  },
  "overrides": {
    "katex": "0.19.0",
    "smol-toml": "1.9.1"
  }
}
